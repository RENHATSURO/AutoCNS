	local function slider(page, text, minV, maxV, initV, step, fmt, onChange)
		local row = newRow(page, 60, false)
		local pad = create("UIPadding", {PaddingLeft = UDim.new(0, 14), PaddingRight = UDim.new(0, 14), Parent = row})

		local nameLbl = label({
			Name = "Main", Size = UDim2.new(0.65, 0, 0, 26), Position = UDim2.fromOffset(0, 6),
			Text = text, Parent = row,
		})
		local valLbl = label({
			Name = "Value", Size = UDim2.new(0.35, 0, 0, 26), Position = UDim2.fromScale(0.65, 0),
			Font = Enum.Font.GothamBold, TextXAlignment = Enum.TextXAlignment.Right,
			Text = "", Parent = row,
		})
		valLbl.Position = UDim2.new(0.65, 0, 0, 6)

		local track = create("Frame", {
			Size = UDim2.new(1, 0, 0, 8),
			Position = UDim2.fromOffset(0, 40),
			BackgroundColor3 = Color3.fromRGB(55, 60, 78),
			BorderSizePixel = 0,
			Parent = row,
		}, {corner(4)})
		local fill = create("Frame", {BackgroundColor3 = C_ACCENT, BorderSizePixel = 0, Parent = track}, {corner(4)})
		local hit = create("TextButton", {
			Size = UDim2.new(1, 0, 0, 26), Position = UDim2.new(0, 0, 0.5, -13),
			BackgroundTransparency = 1, Text = "", AutoButtonColor = false, ZIndex = 3, Parent = track,
		})

		local value = initV
		local function setVal(v, silent)
			v = math.clamp(v, minV, maxV)
			v = math.floor(v / step + 0.5) * step
			value = v
			fill.Size = UDim2.fromScale((v - minV) / (maxV - minV), 1)
			setText(valLbl, fmt and string.format(fmt, v) or tostring(math.floor(v)))
			if not silent and onChange then
				onChange(v)
			end
		end
		setVal(initV, true)

		local dragging = false
		local function fromX(x)
			local t = math.clamp((x - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)
			setVal(minV + t * (maxV - minV))
		end
		hit.InputBegan:Connect(function(input)
			if isClick(input) then
				dragging = true
				fromX(input.Position.X)
			end
		end)
		bind(UserInputService.InputChanged, function(input)
			local t = input.UserInputType
			if dragging and (t == Enum.UserInputType.MouseMovement or t == Enum.UserInputType.Touch) then
				fromX(input.Position.X)
			end
		end)
		bind(UserInputService.InputEnded, function(input)
			if isClick(input) then
				dragging = false
			end
		end)
		return {Get = function() return value end, Set = function(v) setVal(v, true) end}
	end

