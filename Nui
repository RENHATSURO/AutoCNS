	-- ================= HELPERS =================
	local function create(class, props, children)
		local ok, inst = pcall(Instance.new, class)
		if not ok then
			return nil
		end
		local parent
		for k, v in pairs(props or {}) do
			if k == "Parent" then
				parent = v
			else
				pcall(function()
					inst[k] = v
				end)
			end
		end
		for _, child in pairs(children or {}) do
			if child then
				child.Parent = inst
			end
		end
		if parent then
			inst.Parent = parent
		end
		return inst
	end

	local function corner(r)
		return create("UICorner", {CornerRadius = UDim.new(0, r or 8)})
	end

	local function stroke(color, transparency, thickness)
		return create("UIStroke", {Color = color or C_STROKE, Transparency = transparency or 0, Thickness = thickness or 1})
	end

	local function tween(obj, t, props, style, dir)
		local tw = TweenService:Create(obj, TweenInfo.new(t, style or Enum.EasingStyle.Quint, dir or Enum.EasingDirection.Out), props)
		tw:Play()
		return tw
	end

	local function isClick(input)
		local t = input.UserInputType
		return t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.Touch
	end

