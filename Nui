	local function open()
		if isOpen or destroyed then
			return
		end
		isOpen = true
		Window.Visible = true
		TinyToggle.Visible = false
		AsciiHolder.Visible = asciiCfg.enabled

		MainScale.Scale = 0.88
		fade(Window, 0, 0)
		tween(MainScale, 0.55, {Scale = 1}, Enum.EasingStyle.Back)
		fade(Window, 1, 0.35)
		tween(asciiAlpha, 1, {Value = 1}, Enum.EasingStyle.Sine)
		introScramble()
	end

	local function hide(callback)
		if not isOpen then
			if callback then callback() end
			return
		end
		isOpen = false
		tween(MainScale, 0.25, {Scale = 0.9}, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		fade(Window, 0, 0.22)
		tween(asciiAlpha, 0.35, {Value = 0}, Enum.EasingStyle.Quad)
		task.delay(0.36, function()
			if not isOpen then
				Window.Visible = false
				AsciiHolder.Visible = false
			end
			if callback then callback() end
		end)
	end

	function UI.Toggle()
		if destroyed or burnActive then
			return
		end
		if isOpen then
			hide()
		else
			open()
		end
	end

	function UI.Destroy(instant)
		if destroyed then
			return
		end
		destroyed = true
		-- on coupe d'abord toute la logique (farm, noclip, plateforme tween, anti-fling...)
		pcall(Bridge.shutdown)
		local function finish()
			for _, c in ipairs(connections) do
				c:Disconnect()
			end
			asciiAlpha:Destroy()
			ScreenGui:Destroy()
			BurnGui:Destroy()
			if env.__ACNS_TemplateUI == UI then
				env.__ACNS_TemplateUI = nil
			end
		end
		if instant then
			finish()
		else
			hide(finish)
		end
	end

	YesBtn.MouseButton1Click:Connect(function()
		Overlay.Visible = false
		UI.Destroy()
	end)

	-- Fermer (X) -> mini bouton ; "-" -> réduire à la barre de titre
	CloseBtn.MouseButton1Click:Connect(function()
		hide()
		TinyToggle.Visible = true
		scramble(TinyLabel, finalText[TinyLabel], 0.4, 0.2)
	end)

	local minimized = false
	MinBtn.MouseButton1Click:Connect(function()
		minimized = not minimized
		Sidebar.Visible = not minimized
		Panel.Visible = not minimized
		TitleSep.Visible = not minimized
		SideSep.Visible = not minimized
		MinBtn.Text = minimized and "+" or "-"
		tween(Window, 0.2, {Size = minimized and UDim2.fromOffset(WIN_W, TITLE_H) or UDim2.fromOffset(WIN_W, WIN_H)}, Enum.EasingStyle.Quad)
		if not minimized then
			scrambleContainer(pages[currentPage].frame)
		end
	end)

	-- Drag de la fenêtre
	do
		local dragging, dragStart, startPos
		TitleBar.InputBegan:Connect(function(input)
			if not isClick(input) then return end
			dragging, dragStart, startPos = true, input.Position, Window.Position
			local c
			c = input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					dragging = false
					c:Disconnect()
				end
			end)
		end)
		bind(UserInputService.InputChanged, function(input)
			if not dragging then return end
			local t = input.UserInputType
			if t == Enum.UserInputType.MouseMovement or t == Enum.UserInputType.Touch then
				local d = input.Position - dragStart
				Window.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
			end
		end)
	end

	-- Drag du mini bouton (le clic ne compte pas si on a déplacé)
	do
		local dragging, moved, dragStart, startPos = false, false, nil, nil
		TinyToggle.InputBegan:Connect(function(input)
			if not isClick(input) then return end
			dragging, moved, dragStart, startPos = true, false, input.Position, TinyToggle.Position
			local c
			c = input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					dragging = false
					c:Disconnect()
				end
			end)
		end)
		bind(UserInputService.InputChanged, function(input)
			if not dragging then return end
			local t = input.UserInputType
			if t == Enum.UserInputType.MouseMovement or t == Enum.UserInputType.Touch then
				local d = input.Position - dragStart
				if d.Magnitude > 5 then moved = true end
				TinyToggle.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
			end
		end)
		TinyToggle.MouseButton1Click:Connect(function()
			if not moved then
				open()
			end
		end)
	end

	bind(UserInputService.InputBegan, function(input, gpe)
		if not gpe and input.KeyCode == CONFIG.toggleKey then
			UI.Toggle()
		end
	end)

	-- ================= ANTI SCREEN BURN (écran noir, 5 clics pour revenir) =================
	do
		local overlay = create("Frame", {
			Name = "BurnOverlay",
			Size = UDim2.fromScale(1, 1),
			BackgroundColor3 = Color3.fromRGB(0, 0, 0),
			BorderSizePixel = 0,
			Visible = false,
			Active = true,
			Parent = BurnGui,
		})
		label({
			Size = UDim2.new(1, 0, 0, 26), Position = UDim2.new(0, 0, 1, -34),
			Text = "Tap 5x to disable anti screen burn", Font = Enum.Font.Gotham,
			TextColor3 = Color3.fromRGB(28, 28, 28), TextXAlignment = Enum.TextXAlignment.Center, Parent = overlay,
		})

		local clicks = 0
		local function deactivate()
			burnActive = false
			overlay.Visible = false
			clicks = 0
			open()
		end
		local function activate()
			burnActive = true
			clicks = 0
			hide()
			TinyToggle.Visible = false
			overlay.Visible = true
		end
		overlay.InputBegan:Connect(function(input)
			if isClick(input) then
				clicks += 1
				if clicks >= 5 then deactivate() end
			end
		end)
		burnToggleCallback = function()
			if burnActive then deactivate() else activate() end
		end
	end

	-- ================= STATS (morts + uptime) =================
	do
		local startTime = os.clock()
		task.spawn(function()
			while not destroyed do
				local e = math.floor(os.clock() - startTime)
				setText(deathValue, tostring(Bridge.getDeaths()), true)
				setText(uptimeValue, string.format("%02d:%02d:%02d", math.floor(e / 3600), math.floor((e % 3600) / 60), e % 60), true)
				task.wait(1)
			end
		end)
	end

	-- ================= DÉMARRAGE =================
	showPage(1, true)
	env.__ACNS_TemplateUI = UI
	open()
end -- fin du bloc interface
