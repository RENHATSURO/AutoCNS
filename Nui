	local originals = {}   -- surtout pas en weak : les wrappers d'instances seraient collectés
	local fadeExclude = {}

	local function getOriginal(inst)
		local o = originals[inst]
		if o then
			return o
		end
		o = {}
		for _, pair in ipairs(fadeProps) do
			local okIs, is = pcall(inst.IsA, inst, pair[1])
			if okIs and is then
				local ok, v = pcall(function()
					return inst[pair[2]]
				end)
				if ok and type(v) == "number" then
					o[pair[2]] = v
				end
			end
		end
		originals[inst] = o
		inst.Destroying:Connect(function()
			originals[inst] = nil
		end)
		return o
	end

	local function isExcluded(inst)
		for _, root in ipairs(fadeExclude) do
			if inst == root or inst:IsDescendantOf(root) then
				return true
			end
		end
		return false
	end

	local function fade(root, alpha, t)
		local list = root:GetDescendants()
		table.insert(list, root)
		for _, inst in ipairs(list) do
			if not isExcluded(inst) then
				local goal
				for prop, v in pairs(getOriginal(inst)) do
					goal = goal or {}
					goal[prop] = v + (1 - v) * (1 - alpha)
				end
				if goal then
					if t and t > 0 then
						tween(inst, t, goal, Enum.EasingStyle.Quad)
					else
						for p, v in pairs(goal) do
							pcall(function()
								inst[p] = v
							end)
						end
					end
				end
			end
		end
	end

	-- ================= TEXTE BROUILLÉ (scramble, compatible UTF-8) =================
	local glyphs = "!<>-_\\/[]{}=+*^?#@$%&"
	local scrambleIds = {}
	local scrambling = {}
	local finalText = {}   -- texte "officiel" de chaque label suivi

	local function splitChars(s)
		local t = {}
		local ok = pcall(function()
			for _, c in utf8.codes(s) do
				t[#t + 1] = utf8.char(c)
			end
		end)
		if not ok then
			t = {}
			for i = 1, #s do
				t[i] = s:sub(i, i)
			end
		end
		return t
	end

	local function scramble(lbl, text, duration, delay)
		local id = (scrambleIds[lbl] or 0) + 1
		scrambleIds[lbl] = id
		scrambling[lbl] = true
		local list = splitChars(text)
		local len = #list
		task.spawn(function()
			if delay and delay > 0 then
				lbl.Text = ""
				task.wait(delay)
			end
			local start = os.clock()
			while lbl.Parent and scrambleIds[lbl] == id do
				local p = (os.clock() - start) / duration
				if p >= 1 then
					break
				end
				local revealed = math.floor(p * len)
				local out = table.create(len)
				for i = 1, len do
					local ch = list[i]
					if i <= revealed or ch == " " then
						out[i] = ch
					else
						local r = math.random(1, #glyphs)
						out[i] = glyphs:sub(r, r)
					end
				end
				lbl.Text = table.concat(out)
				task.wait(0.03)
			end
			if scrambleIds[lbl] == id then
				lbl.Text = finalText[lbl] or text
				scrambling[lbl] = false
			end
		end)
	end

	-- soft = true : si un scramble est en cours, on met juste à jour le texte final.
	local function setText(lbl, text, soft)
		finalText[lbl] = text
		if soft and scrambling[lbl] then
			return
		end
		scrambleIds[lbl] = (scrambleIds[lbl] or 0) + 1
		scrambling[lbl] = false
		lbl.Text = text
	end

	local function label(props)
		props.BackgroundTransparency = 1
		props.BorderSizePixel = 0
		props.Font = props.Font or Enum.Font.GothamSemibold
		props.TextSize = props.TextSize or 14
		props.TextScaled = false
		props.TextColor3 = props.TextColor3 or C_TXT
		props.TextXAlignment = props.TextXAlignment or Enum.TextXAlignment.Left
		local l = create("TextLabel", props)
		finalText[l] = l.Text
		return l
	end

	local function scrambleContainer(root)
		local rank = 0
		for _, d in ipairs(root:GetDescendants()) do
			if d:IsA("TextLabel") and finalText[d] and finalText[d] ~= "" then
				local delay = math.min(rank * CONFIG.scramble.stagger, CONFIG.scramble.maxDelay)
				scramble(d, finalText[d], CONFIG.scramble.pageDuration, delay)
				rank += 1
			end
		end
	end

