	local pages = {}
	local currentPage

	local function showPage(index, instant)
		if index == currentPage then
			return
		end
		local prev = currentPage
		local dir = (prev and index < prev) and -1 or 1
		currentPage = index

		for i, p in ipairs(pages) do
			local active = i == index
			if instant then
				p.button.BackgroundTransparency = active and 0.65 or 1
				p.label.TextColor3 = active and C_TXT or C_SUBTXT
				p.accent.Size = active and UDim2.fromOffset(3, 22) or UDim2.fromOffset(3, 0)
			else
				tween(p.button, 0.15, {BackgroundTransparency = active and 0.65 or 1}, Enum.EasingStyle.Quad)
				tween(p.label, 0.15, {TextColor3 = active and C_TXT or C_SUBTXT}, Enum.EasingStyle.Quad)
				tween(p.accent, 0.25, {Size = active and UDim2.fromOffset(3, 22) or UDim2.fromOffset(3, 0)})
			end
		end

		if prev then
			local old = pages[prev].frame
			if instant then
				old.Visible = false
			else
				fade(old, 0, 0.15)
				tween(old, 0.25, {Position = UDim2.fromScale(-0.06 * dir, 0)})
				task.delay(0.25, function()
					if pages[currentPage].frame ~= old then
						old.Visible = false
					end
				end)
			end
		end

		local new = pages[index].frame
		new.Visible = true
		if instant then
			new.Position = UDim2.new()
		else
			new.Position = UDim2.fromScale(0.06 * dir, 0)
			fade(new, 0, 0)
			tween(new, 0.4, {Position = UDim2.new()})
			fade(new, 1, 0.3)
			scrambleContainer(new)
		end
	end

