	local burnClickCount = 0
	local burnConn: RBXScriptConnection?

	local function deactivateBurn()
		antiScreenBurnActive = false
		burnOverlay.Visible = false
		window.Visible = true
		tinyToggle.Visible = false
		if burnConn then burnConn:Disconnect(); burnConn = nil end
		burnClickCount = 0
	end

	local function activateBurn()
		antiScreenBurnActive = true
		window.Visible = false
		tinyToggle.Visible = false
		burnOverlay.Visible = true
		burnClickCount = 0
		if burnConn then burnConn:Disconnect() end
		burnConn = burnOverlay.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1
				or input.UserInputType == Enum.UserInputType.Touch then
				burnClickCount += 1
				if burnClickCount >= 5 then deactivateBurn() end
			end
		end)
	end

	burnClicker_ref.MouseButton1Click:Connect(function()
		if not antiScreenBurnActive then activateBurn() else deactivateBurn() end
	end)

