		local list = Instance.new("UIListLayout", f)
		list.Padding = UDim.new(0, 6)
		list.SortOrder = Enum.SortOrder.LayoutOrder
		list.HorizontalAlignment = Enum.HorizontalAlignment.Left
		f.Parent = panel
		pageFrames[name] = {}
		return f
	end

	local function showPage(name: string)
		for _, child in ipairs(panel:GetChildren()) do
			if child:IsA("Frame") and child.Name ~= "" then child.Visible = false end
		end
		for pname, btn in pairs(sidebarButtons) do
			for _, c in ipairs(btn:GetChildren()) do
				if c:IsA("Frame") and c.Name == "Accent" then c.Visible = false end
				if c:IsA("TextLabel") then tw(c, FAST, { TextColor3 = C_SUBTXT }) end
			end
			tw(btn, FAST, { BackgroundTransparency = 1 })
		end
		activePageName = name
		local target = panel:FindFirstChild(name)
		if target then target.Visible = true end
		local btn = sidebarButtons[name]
		if btn then
			tw(btn, FAST, { BackgroundTransparency = 0.65 })
			for _, c in ipairs(btn:GetChildren()) do
				if c:IsA("Frame") and c.Name == "Accent" then c.Visible = true end
				if c:IsA("TextLabel") then tw(c, FAST, { TextColor3 = C_TXT }) end
			end
		end
	end

