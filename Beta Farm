	local function makeDialogBtn(x: number, txt: string, col: Color3, hov: Color3): TextButton
		local b = Instance.new("TextButton")
		b.Size = UDim2.fromOffset(118, 36)
		b.Position = UDim2.fromOffset(x, 82)
		b.Text = txt
		b.Font = Enum.Font.GothamBold
		b.TextScaled = true
		b.TextColor3 = C_TXT
		b.BackgroundColor3 = col
		b.ZIndex = 22
		b.AutoButtonColor = false
		b.Parent = dialog
		Instance.new("UICorner", b).CornerRadius = UDim.new(0, 8)
		b.MouseEnter:Connect(function() tw(b, FAST, { BackgroundColor3 = hov }) end)
		b.MouseLeave:Connect(function() tw(b, FAST, { BackgroundColor3 = col }) end)
		return b
	end

