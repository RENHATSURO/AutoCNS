		nameLbl.TextXAlignment = Enum.TextXAlignment.Left
		nameLbl.TextSize = 14
		nameLbl.TextScaled = false
		nameLbl.Parent = topRow

		local valLbl = Instance.new("TextLabel")
		valLbl.Size = UDim2.fromScale(0.35, 1)
		valLbl.Position = UDim2.fromScale(0.65, 0)
		valLbl.BackgroundTransparency = 1
		valLbl.Font = Enum.Font.GothamBold
		valLbl.TextColor3 = C_TXT
		valLbl.TextXAlignment = Enum.TextXAlignment.Right
		valLbl.TextSize = 14
		valLbl.TextScaled = false
		valLbl.Parent = topRow

		local track = Instance.new("Frame")
		track.Size = UDim2.new(1, 0, 0, 8)
		track.Position = UDim2.fromOffset(0, 40)
		track.BackgroundColor3 = Color3.fromRGB(55, 60, 78)
		track.BorderSizePixel = 0
		track.Parent = row
		Instance.new("UICorner", track).CornerRadius = UDim.new(1, 0)

		local fill = Instance.new("Frame")
		fill.BackgroundColor3 = C_ACCENT
		fill.BorderSizePixel = 0
		fill.Parent = track
		Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)

		local currentVal = initV
		local function setVal(v: number)
			v = math.clamp(v, minV, maxV)
			v = math.floor(v / 0.01 + 0.5) * 0.01
			currentVal = v
			local t = (v - minV) / (maxV - minV)
			fill.Size = UDim2.fromScale(t, 1)
			valLbl.Text = fmt and string.format(fmt, v) or tostring(math.floor(v))
		end
		setVal(initV)

		local sliderDragging = false
		local clicker = Instance.new("TextButton")
		clicker.Size = UDim2.fromScale(1, 1)
		clicker.BackgroundTransparency = 1
		clicker.Text = ""
		clicker.AutoButtonColor = false
		clicker.Parent = track
		clicker.InputBegan:Connect(function(i)
			if i.UserInputType == Enum.UserInputType.MouseButton1 then sliderDragging = true end
		end)
		UserInputService.InputEnded:Connect(function(i)
			if i.UserInputType == Enum.UserInputType.MouseButton1 then sliderDragging = false end
		end)
		RunService.RenderStepped:Connect(function()
			if not sliderDragging then return end
			local m = player:GetMouse()
			local x = math.clamp((m.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
			setVal(minV + x * (maxV - minV))
		end)

		return row, function() return currentVal end
	end

