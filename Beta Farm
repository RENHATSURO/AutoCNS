-- ================= COINS =================
-- Système événementiel : la liste est maintenue en temps réel via DescendantAdded/Removing.
-- On ne re-scanne jamais tout le workspace dans la boucle de farm.
local coinBlacklist: { [Instance]: number } = {}
local coinSet: { [Instance]: true } = {}   -- ensemble live des Coin_Server présents
local coinConnAdded: RBXScriptConnection?
local coinConnRemoving: RBXScriptConnection?

local function isCoinBlacklisted(coin: Instance): boolean
	local t = coinBlacklist[coin]
	if not t then return false end
	if os.clock() > t then coinBlacklist[coin] = nil; return false end
	return true
end

local function getPos(obj: Instance): Vector3
	if obj:IsA("BasePart") then return obj.Position end
	return obj:GetPivot().Position
end

-- Peuple le coinSet depuis l'état actuel du workspace (appelé une seule fois au démarrage).
local function initCoinCache()
	table.clear(coinSet)
	for _, v in ipairs(workspace:GetDescendants()) do
		if v.Name == "Coin_Server" then coinSet[v] = true end
	end
end

-- Connecte les événements workspace pour maintenir coinSet à jour sans re-scan.
local function startCoinWatcher()
	if coinConnAdded then coinConnAdded:Disconnect() end
	if coinConnRemoving then coinConnRemoving:Disconnect() end
	coinConnAdded = workspace.DescendantAdded:Connect(function(v)
		if v.Name == "Coin_Server" then coinSet[v] = true end
	end)
	coinConnRemoving = workspace.DescendantRemoving:Connect(function(v)
		if coinSet[v] then coinSet[v] = nil end
	end)
end

-- Initialisation immédiate (remplace refreshCoins dans la boucle de farm).
initCoinCache()
startCoinWatcher()

-- refreshCoins est conservée pour la compatibilité avec le reste du code,
-- mais elle ne fait désormais qu'expirer les entrées de blacklist périmées,
-- sans jamais toucher à workspace:GetDescendants().
local function refreshCoins()
	-- Nettoyage passif du blacklist expiré (O(k) sur les seules pièces blacklistées).
	local now = os.clock()
	for coin, expiry in pairs(coinBlacklist) do
		if now > expiry then coinBlacklist[coin] = nil end
	end
end

local function getNearestCoin(): Instance?
	if not rootPart then return nil end
	local best: Instance? = nil
	local bestDist = math.huge
	local myPos = rootPart.Position
	for coin in pairs(coinSet) do
		if not isCoinBlacklisted(coin) then
			local d = (getPos(coin) - myPos).Magnitude
			if d < bestDist and d < LOBBY_IGNORE_DISTANCE then
				bestDist = d; best = coin
			end
		end
	end
	return best
end

-- ================= PATH =================
local function computePath(from: Vector3, to: Vector3): Path?
	if (to - from).Magnitude > MAX_PATH_DISTANCE then return nil end
	local ok, path = pcall(function()
		local p = PathfindingService:CreatePath({
			AgentRadius = 1.8, AgentHeight = 5, AgentCanJump = true,
			AgentJumpHeight = 12, AgentMaxSlope = 50, WaypointSpacing = 2,
		})
		p:ComputeAsync(from, to)
		if p.Status == Enum.PathStatus.Success then return p end
		return nil
	end)
	if not ok then return nil end
	return path
end

local function shouldForceDrop(targetPos: Vector3): boolean
	if not rootPart then return false end
	if rootPart.Position.Y - targetPos.Y < DROP_HEIGHT_ALLOW then return false end
	local localRay = RaycastParams.new()
	localRay.FilterDescendantsInstances = { player.Character }
	localRay.FilterType = Enum.RaycastFilterType.Blacklist
	return workspace:Raycast(rootPart.Position, rootPart.CFrame.LookVector * DROP_CHECK_DISTANCE, localRay) == nil
end

-- ================= MOVEMENT =================
local activeTween: Tween?
local activePlatformTween: Tween?
local tweenPlatform: Part?
local TWEEN_PLATFORM_SIZE  = Vector3.new(6, 1, 6)
local TWEEN_PLATFORM_COLOR = Color3.fromRGB(57, 255, 20)

local function destroyTweenPlatform()
	if activePlatformTween then activePlatformTween:Cancel(); activePlatformTween = nil end
	if tweenPlatform then tweenPlatform:Destroy(); tweenPlatform = nil end
end

local function getUnderFeetOffset(): number
	if not humanoid or not rootPart then return 3 end
	return humanoid.HipHeight + rootPart.Size.Y * 0.5 + 0.5
end

local function getTweenPlatformPosition(): Vector3?
	if not rootPart or not humanoid then return nil end
	return rootPart.Position - Vector3.new(0, getUnderFeetOffset(), 0)
end

local function ensureTweenPlatform()
	if moveMode ~= "Tween" then destroyTweenPlatform(); return end
	if not rootPart or not humanoid then destroyTweenPlatform(); return end
	if not tweenPlatform then
		local part = Instance.new("Part")
		part.Name = "TweenFloatPlatform"; part.Size = TWEEN_PLATFORM_SIZE
		part.Anchored = true; part.CanCollide = true; part.CanQuery = false; part.CanTouch = false
		part.Material = Enum.Material.Neon; part.Color = TWEEN_PLATFORM_COLOR
		part.Transparency = 0; part.TopSurface = Enum.SurfaceType.Smooth; part.BottomSurface = Enum.SurfaceType.Smooth
		part.Parent = workspace; tweenPlatform = part
	end
	if not activePlatformTween or activePlatformTween.PlaybackState ~= Enum.PlaybackState.Playing then
		local p = getTweenPlatformPosition()
		if p then tweenPlatform.CFrame = CFrame.new(p) end
	end
end

local function safeMoveTo(pos: Vector3, timeout: number): boolean
	if not humanoid or not rootPart then return false end
	humanoid:MoveTo(pos)
	local start = os.clock()
	while os.clock() - start < timeout do
		if not scriptEnabled or not autoFarm then return false end
		if (rootPart.Position - pos).Magnitude < 4 then return true end
		task.wait(0.05)
	end
	return false
end

local function moveTo(target: Vector3, path: Path?): boolean
	if not humanoid or not rootPart then return false end
	if moveMode == "Tween" then
		ensureTweenPlatform()
		if activeTween then activeTween:Cancel() end
		if activePlatformTween then activePlatformTween:Cancel() end
		local dist = (rootPart.Position - target).Magnitude
		local travelTime = math.max(dist / tweenSpeed, 0.05)
		local tweenTarget = target + Vector3.new(0, tweenYOffset, 0)
		if tweenPlatform then
			activePlatformTween = TweenService:Create(tweenPlatform, TweenInfo.new(travelTime, Enum.EasingStyle.Linear),
				{ CFrame = CFrame.new(tweenTarget - Vector3.new(0, getUnderFeetOffset(), 0)) })
			activePlatformTween:Play()
		end
		activeTween = TweenService:Create(rootPart, TweenInfo.new(travelTime, Enum.EasingStyle.Linear), { CFrame = CFrame.new(tweenTarget) })
		activeTween:Play(); activeTween.Completed:Wait()
		if tweenPlatform then
			local fp = getTweenPlatformPosition()
			if fp then tweenPlatform.CFrame = CFrame.new(fp) end
		end
		return true
	end
	if moveMode == "Walk" then return safeMoveTo(target, 2) end
	if moveMode == "Pathfinding" and path then
		local waypoints = path:GetWaypoints()
		for i, wp in ipairs(waypoints) do
			if not scriptEnabled or not autoFarm then return false end
			local targetPos = wp.Position
			if i < #waypoints then
				local delta = waypoints[i+1].Position - targetPos
				if delta.Magnitude > 0 then targetPos += delta.Unit * 1.5 end
			end
			if wp.Action == Enum.PathWaypointAction.Jump then humanoid.Jump = true end
			if not safeMoveTo(targetPos, 2.5) then return false end
		end
		return true
	end
	return false
end

RunService.RenderStepped:Connect(function()
	if not scriptEnabled then destroyTweenPlatform(); return end
	if moveMode == "Tween" then ensureTweenPlatform() else destroyTweenPlatform() end
end)

-- ================= AUTO JUMP =================
RunService.RenderStepped:Connect(function()
	if not scriptEnabled or not autoJumpEnabled or not humanoid or not rootPart then return end
	if humanoid:GetState() == Enum.HumanoidStateType.Climbing then return end
	if tick() - lastJump < JUMP_COOLDOWN then return end
	if humanoid.FloorMaterial == Enum.Material.Air then return end
	local result = workspace:Raycast(rootPart.Position + Vector3.new(0, RAY_HEIGHT_OFFSET, 0), rootPart.CFrame.LookVector * RAY_DISTANCE, rayParams)
	if result and result.Instance and result.Instance.CanCollide then
		humanoid:ChangeState(Enum.HumanoidStateType.Jumping); lastJump = tick()
	end
end)

-- ================= AUTO WALK IF IDLE =================
local idleTimer = 0
local isAutoMoving = false
local lastPosition: Vector3? = nil

local function getRandomDir()
	local a = math.random() * math.pi * 2
	return Vector3.new(math.cos(a), 0, math.sin(a))
end

local function isWallAhead(dir: Vector3): boolean
	if not rootPart then return false end
	local r = workspace:Raycast(rootPart.Position, dir.Unit * WALL_DETECTION_DISTANCE, rayParams)
	return r ~= nil and r.Instance ~= nil and r.Instance.CanCollide
end

RunService.Heartbeat:Connect(function(dt)
	if not scriptEnabled or not autoWalkIfIdleEnabled then
		idleTimer = 0; isAutoMoving = false
		if rootPart then lastPosition = rootPart.Position end; return
	end
	if not humanoid or not rootPart then return end
	if not lastPosition then lastPosition = rootPart.Position end
	if (rootPart.Position - lastPosition).Magnitude > POSITION_EPSILON then
		idleTimer = 0; isAutoMoving = false
	else
		idleTimer += dt
	end
	lastPosition = rootPart.Position
	if idleTimer >= IDLE_TIME and not isAutoMoving then
		isAutoMoving = true; idleTimer = 0
		task.spawn(function()
			if not humanoid or not rootPart then isAutoMoving = false; return end
			local dir = getRandomDir()
			for _ = 1, 8 do if not isWallAhead(dir) then break end; dir = getRandomDir() end
			humanoid:MoveTo(rootPart.Position + dir.Unit * MOVE_DISTANCE)
			humanoid.MoveToFinished:Wait(); isAutoMoving = false
		end)
	end
end)

-- ================= AUTO RESET ON FULL BAG =================
local bagResetDebounce = false
task.spawn(function()
	local ok, coinEvent = pcall(function()
		return ReplicatedStorage:WaitForChild("Remotes",10):WaitForChild("Gameplay",10):WaitForChild("CoinCollected",10)
	end)
	if not ok or not coinEvent then warn("AutoCNS: CoinCollected remote not found."); return end
	coinEvent.OnClientEvent:Connect(function(_, current, max)
		if not autoResetOnFullBag or bagResetDebounce or current < max then return end
		bagResetDebounce = true
		local char = player.Character or player.CharacterAdded:Wait()
		local hum  = char:FindFirstChildOfClass("Humanoid")
		local root = char:FindFirstChild("HumanoidRootPart")
		if moveMode == "Tween" and root then
			if activeTween then activeTween:Cancel(); activeTween = nil end
			if activePlatformTween then activePlatformTween:Cancel(); activePlatformTween = nil end
			local was = autoFarm; autoFarm = false
			root.CFrame = CFrame.new(0, 10000, 0); task.wait(1); autoFarm = was
		end
		if hum then hum.Health = 0 end
		task.wait(5); bagResetDebounce = false
	end)
end)

-- ================= NOCLIP =================
local noclipDisabledParts: { [BasePart]: true } = {}
local NOCLIP_ZONE = Vector3.new(20, 20, 20)
local noclipOverlap = OverlapParams.new()
noclipOverlap.FilterType = Enum.RaycastFilterType.Blacklist

local function updateNoclipFilter()
	local ex: { Instance } = {}
	if player.Character then table.insert(ex, player.Character) end
	if tweenPlatform then table.insert(ex, tweenPlatform) end
	noclipOverlap.FilterDescendantsInstances = ex
end

local function noclipScanOnce()
	if not rootPart then return end
	updateNoclipFilter()
	for _, part in ipairs(workspace:GetPartBoundsInBox(CFrame.new(rootPart.Position), NOCLIP_ZONE, noclipOverlap)) do
		if part == tweenPlatform then continue end
		if player.Character and part:IsDescendantOf(player.Character) then continue end
		if part.CanCollide and not noclipDisabledParts[part] then
			part.CanCollide = false; noclipDisabledParts[part] = true
		end
	end
end

local function restoreNoclipParts()
	for part in pairs(noclipDisabledParts) do
		pcall(function() if part.Parent then part.CanCollide = true end end)
	end
	table.clear(noclipDisabledParts)
end

local function startNoclipLoop()
	task.spawn(function()
		while noclipEnabled and scriptEnabled do noclipScanOnce(); task.wait(0.1) end
	end)
end

-- ================= ANTI FLING =================
local antiFlingDisabledParts: { [BasePart]: true } = {}

local function applyAntiFling()
	for _, op in ipairs(Players:GetPlayers()) do
		if op == player or not op.Character then continue end
		for _, part in ipairs(op.Character:GetDescendants()) do
			if part:IsA("BasePart") and part.CanCollide and not antiFlingDisabledParts[part] then
				part.CanCollide = false; antiFlingDisabledParts[part] = true
			end
		end
	end
end

local function restoreAntiFling()
	for part in pairs(antiFlingDisabledParts) do
		pcall(function() if part.Parent then part.CanCollide = true end end)
	end
	table.clear(antiFlingDisabledParts)
end

task.spawn(function()
	while scriptEnabled do
		if antiFlingEnabled then applyAntiFling() end
		task.wait(1)
	end
end)

Players.PlayerAdded:Connect(function(p)
	p.CharacterAdded:Connect(function(char)
		if not antiFlingEnabled then return end
		task.wait(1)
		for _, part in ipairs(char:GetDescendants()) do
			if part:IsA("BasePart") and part.CanCollide and not antiFlingDisabledParts[part] then
				part.CanCollide = false; antiFlingDisabledParts[part] = true
			end
		end
	end)
end)

-- ================= SECURITY SHUTDOWN =================
local function securityShutdown(reason: string)
	print("AutoCNS SECURITY:", reason)
	autoFarm = false; noclipEnabled = false
	restoreNoclipParts()
	if activeTween then activeTween:Cancel() end
	if activePlatformTween then activePlatformTween:Cancel() end
	destroyTweenPlatform(); scriptEnabled = false
end

-- ================= BLACKLIST CHECK =================
local function isUserBlacklisted(uid: number): boolean
	for _, id in ipairs(BLACKLISTED_USER_IDS) do if id == uid then return true end end
	return false
end

task.spawn(function()
	while true do
		task.wait(2); if not scriptEnabled then break end
		if not blacklistedPlayerEnabled then continue end
		for _, p in ipairs(Players:GetPlayers()) do
			if p == player then continue end
			if isUserBlacklisted(p.UserId) then
				warn("INTRUDER DETECTED")
				securityShutdown("Blacklisted: " .. p.Name .. " (" .. tostring(p.UserId) .. ")")
				break
			end
		end
	end
end)

-- ================= ANTI UNKNOWN PLAYER =================
local knownPlayerIds: { [number]: true } = {}
local antiUnknownInitialized = false

local function initAntiUnknown()
	table.clear(knownPlayerIds)
	for _, p in ipairs(Players:GetPlayers()) do knownPlayerIds[p.UserId] = true end
	antiUnknownInitialized = true
end

task.spawn(function()
	while true do
		task.wait(2); if not scriptEnabled then break end
		if not antiUnknownPlayerEnabled then antiUnknownInitialized = false; continue end
		if not antiUnknownInitialized then initAntiUnknown(); continue end
		local cur: { [number]: true } = {}
		for _, p in ipairs(Players:GetPlayers()) do cur[p.UserId] = true end
		for id in pairs(cur) do
			if not knownPlayerIds[id] then
				warn("INTRUDER DETECTED")
				securityShutdown("Unknown player joined: " .. tostring(id)); break
			end
		end
		if not scriptEnabled then break end
		for id in pairs(knownPlayerIds) do
			if not cur[id] then securityShutdown("Player left (Anti Unknown triggered)"); break end
		end
	end
end)

-- ================= FARM LOOP =================
task.spawn(function()
	local lockedTarget: Instance?
	local targetStart = 0
	local localLastPos: Vector3?
	local lastMove = 0
	local lastBlacklistClean = 0   -- nettoyage du blacklist espacé (1 s suffit)
	while scriptEnabled do
		task.wait(0.05)
		local ok, err = pcall(function()
			if not autoFarm or not humanoid or not rootPart then lockedTarget = nil; return end
			-- Nettoyage du blacklist une fois par seconde au lieu de 20x/s.
			local now = os.clock()
			if now - lastBlacklistClean >= 1 then refreshCoins(); lastBlacklistClean = now end
			if not lockedTarget or isCoinBlacklisted(lockedTarget) then
				lockedTarget = getNearestCoin()
				if not lockedTarget then return end
				targetStart = os.clock(); localLastPos = rootPart.Position; lastMove = os.clock()
			end
			local coin = lockedTarget
			if not coin then return end
			if os.clock() - targetStart > MAX_TARGET_TIME then
				coinBlacklist[coin] = os.clock() + blacklistDuration; lockedTarget = nil; return
			end
			if localLastPos and (rootPart.Position - localLastPos).Magnitude > STUCK_DISTANCE then
				localLastPos = rootPart.Position; lastMove = os.clock()
			elseif os.clock() - lastMove > STUCK_TIME then
				if tpIfStuck then rootPart.CFrame = CFrame.new(getPos(coin)) end
				coinBlacklist[coin] = os.clock() + blacklistDuration; lockedTarget = nil; return
			end
			local path
			if moveMode == "Pathfinding" then
				path = computePath(rootPart.Position, getPos(coin))
				if not path and shouldForceDrop(getPos(coin)) then humanoid:MoveTo(getPos(coin)); return end
				if not path then coinBlacklist[coin] = os.clock() + 2; lockedTarget = nil; return end
			end
			moveTo(getPos(coin), path)
			coinBlacklist[coin] = os.clock() + blacklistDuration; lockedTarget = nil
			if postCollectDelay > 0 then task.wait(postCollectDelay) end
		end)
		if not ok then warn("Autofarm error:", err); task.wait(0.5) end
	end
end)

