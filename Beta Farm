	local startTime = os.clock()
	task.spawn(function()
		while scriptEnabled do
			if deathVal_ref then deathVal_ref.Text = tostring(deathCount) end
			local e = math.floor(os.clock() - startTime)
			if uptimeVal_ref then
				uptimeVal_ref.Text = string.format("%02d:%02d:%02d", math.floor(e/3600), math.floor((e%3600)/60), e%60)
			end
			task.wait(1)
		end
	end)

